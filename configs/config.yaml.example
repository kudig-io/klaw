# Klaw 配置文件

kubernetes:
  clusters:
    - name: default
      kubeconfig: ~/.kube/config
      context: minikube

messaging:
  dingtalk:
    enabled: false
    app_key: your_app_key
    app_secret: your_app_secret
    webhook: your_webhook_url
    secret: your_secret
  feishu:
    enabled: false
    app_id: your_app_id
    app_secret: your_app_secret

openclaw:
  enabled: true
  skills: ./skills

server:
  port: 8080
  auth:
    enabled: true
    # 也可通过环境变量 KLAW_API_TOKEN 注入，避免密钥落盘
    token: change-me
  cors:
    # 跨域白名单；留空表示仅允许同源
    allowed_origins: []
    # allowed_origins:
    #   - https://klaw.example.com
  ops:
    # ChatOps 破坏性命令（如 pod delete）总开关，默认关闭；
    # 群聊中任何人 @ 机器人都能发命令，删除类操作需显式开启
    # 也可用环境变量 KLAW_OPS_ALLOW_DESTRUCTIVE=true 注入
    allow_destructive: false

# SOS 语音应急快速对话
sos:
  enabled: false
  provider: dashscope      # dashscope | glm（智谱 GLM-Realtime）
  dashscope:
    api_key: ""            # 或环境变量 KLAW_SOS_DASHSCOPE_API_KEY
    workspace_id: ""       # 百炼 Workspace ID
    region: "cn-beijing"
    model: "qwen3.5-omni-plus-realtime"
    voice: "Ethan"
  glm:
    api_key: ""            # 形如 {id}.{secret}，或环境变量 KLAW_SOS_GLM_API_KEY
    model: "glm-realtime"
    voice: ""              # 可选音色
  faq_file: ""             # 可选外部语料路径
  instructions_prefix: ""
